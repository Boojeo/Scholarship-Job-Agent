# ---- Which AI does the agent use?
#   claude_code = your Claude Pro/Max plan through the Claude Code CLI (no API key; run `claude` once to log in)
#   gemini | anthropic (API key) | ollama (local)
LLM_PROVIDER=claude_code
# Model aliases for Claude Code: haiku for screening (light on plan limits), sonnet for writing documents
CLAUDE_CODE_MODEL_FAST=haiku
CLAUDE_CODE_MODEL_SMART=sonnet
# Only if `claude` is not found automatically: full path, e.g. C:\Users\you\.local\bin\claude.exe
CLAUDE_CODE_PATH=

# ---- Gemini (optional, only if LLM_PROVIDER=gemini; free tier from https://aistudio.google.com/apikey). Several keys allowed, comma separated.
# Quota is per Google Cloud project, so keys from the same project share one limit.
GEMINI_API_KEYS=
# Model names change often and old ones close to new accounts. Run `python main.py probe` to see what works.
# Google Search grounding needs a paid plan; the research step uses free DuckDuckGo + page download instead.
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_MODEL_RESEARCH=gemini-3.8-flash

# ---- Anthropic (optional, better writing for CV/SOP). Leave empty if you have no key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5

# ---- Ollama (optional, fully local and free)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Candidate contact details used on forms. Stay on your PC, never in git.
CANDIDATE_EMAIL=Abdullammd1@gmail.com
CANDIDATE_PHONE=
CANDIDATE_TIMEZONE=Asia/Riyadh

# ---- Telegram bot (create one with @BotFather, paste its token here)
TELEGRAM_BOT_TOKEN=
# Leave empty: the first person who sends /start becomes the owner and is saved to data/owner.json.
TELEGRAM_OWNER_ID=
# Daily digest time in CANDIDATE_TIMEZONE, 24h format
DIGEST_TIME=09:00
# Only opportunities scoring at least this (0-100) reach the digest
MATCH_THRESHOLD=60

# ---- Paths and pacing
DB_PATH=data/autopilot.sqlite3
DATA_DIR=data
RESEARCH_DELAY_SECONDS=8
